APP_NAME=Voca
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# SQLite needs no server. For production use a supported MySQL 8 installation.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=voca
# DB_USERNAME=voca
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true on an HTTPS production deployment.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Optional until the voice / realtime milestones are implemented.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Set to your actual reverse proxy IPs/CIDRs. Never trust arbitrary proxies in production.
TRUSTED_PROXIES=127.0.0.1
VITE_APP_NAME="${APP_NAME}"

# Milestone 3: Real-Time Browser Voice Engine (LiveKit + Separate Python Worker)
# Opt in only after configuring reachable LiveKit infrastructure and the worker service.
VOICE_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_WORKER_NAME=voca-browser-v1
VOICE_WORKER_KEY_ID=v1
VOICE_WORKER_SECRET=
VOICE_ALLOW_INSECURE_LOCAL=false

