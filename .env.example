APP_NAME=Voca
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# SQLite needs no server. For production use a supported MySQL 8 installation.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=voca
# DB_USERNAME=voca
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true on an HTTPS production deployment.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Optional until the voice / realtime milestones are implemented.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Set to your actual reverse proxy IPs/CIDRs. Never trust arbitrary proxies in production.
TRUSTED_PROXIES=127.0.0.1
VITE_APP_NAME="${APP_NAME}"

# Real-Time Browser Voice Engine (LiveKit + Separate Python Worker)
# Follow COMMAND_MANUAL.md sections 3-5: start LiveKit first, then generate the
# secrets below, then enable voice. Opt in only with reachable infrastructure.
#
# VOICE_ENABLED=true unlocks the Playground. It is not a health check; run
# php artisan voca:doctor to verify LiveKit, the worker, and providers for real.
VOICE_ENABLED=false
# Use ws://127.0.0.1:7880 ONLY for local development with VOICE_ALLOW_INSECURE_LOCAL=true.
# Any shared/staging/production server must use wss:// with a valid certificate.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match the name the Python worker registers under (voice-worker/.env).
VOICE_WORKER_NAME=voca-browser-v1
VOICE_WORKER_KEY_ID=v1
# Never reuse LIVEKIT_API_SECRET or APP_KEY here. Generate:
#   php -r "echo bin2hex(random_bytes(32)) . PHP_EOL;"
# The identical value must be set in voice-worker/.env.
VOICE_WORKER_SECRET=
# HTTP endpoint Laravel probes for the worker's LiveKit registration health (port 8081).
VOICE_WORKER_HEALTH_URL=http://127.0.0.1:8081
# Local development only. Never true on any shared or production server.
VOICE_ALLOW_INSECURE_LOCAL=false

