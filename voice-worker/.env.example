# Independent worker process. Populate using the deployment secret store, never a frontend VITE_* variable.
# Same LiveKit project and worker name as the Laravel installation.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
VOICE_WORKER_NAME=voca-browser-v1

# HTTPS origin of Laravel, no path/query/userinfo. Only allow local HTTP for a local machine.
VOCA_CONTROL_URL=
VOICE_WORKER_KEY_ID=v1
VOICE_WORKER_SECRET=
VOICE_ALLOW_INSECURE_LOCAL=false

# No global OPENAI_API_KEY: each authorized job receives its own current M2 provider key.
# Never set OPENAI_API_VERSION, LK_OPENAI_DEBUG, recording, or raw content telemetry.
