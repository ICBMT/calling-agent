[Unit]
Description=Voca AI Calling Agent - Queue Worker
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/voca
ExecStart=/usr/bin/php /var/www/voca/artisan queue:work --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=5s
TimeoutStopSec=60s
KillMode=process
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
