{
    "name": "voca",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite --host 0.0.0.0",
        "test:unit": "node --test tests/Js/**/*.test.js",
        "test:browser": "npm run build && playwright test",
        "format": "prettier --write \"resources/js/**/*.js\" \"resources/css/**/*.css\" \"tests/Browser/**/*.js\" \"*.{js,json,md}\"",
        "format:check": "prettier --check \"resources/js/**/*.js\" \"resources/css/**/*.css\" \"tests/Browser/**/*.js\" \"*.{js,json,md}\""
    },
    "dependencies": {
        "@fontsource-variable/manrope": "^5.2.0",
        "alpinejs": "^3.14.9",
        "gsap": "^3.14.2",
        "lenis": "^1.3.17",
        "livekit-client": "2.23.0",
        "three": "^0.185.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@playwright/test": "^1.56.1",
        "@tailwindcss/vite": "^4.1.0",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.1.0",
        "vite": "^8.0.0"
    }
}
